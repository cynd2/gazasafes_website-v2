REDIS_URL=redis://:change-me@localhost:6379
EVENTS_STREAM=events:raw
CONSUMER_GROUP=workers
CONSUMER_NAME=worker-1
BATCH_SIZE=50
BLOCK_MS=5000

DATABASE_URL=postgres://analytics:change-me@localhost:5432/analytics

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=change-me

# Optional: path to a GeoLite2-City.mmdb file. Leave unset during dev, geo
# enrichment is skipped gracefully (planmode.md §5).
GEOIP_DB_PATH=

IP_HASH_PEPPER=change-me-to-a-long-random-string
SESSION_GAP_SECONDS=1800
