POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

REDIS_PASSWORD=change-me
REDIS_PORT=6379

# ingestion-api
INGESTION_PORT=8787
EVENTS_STREAM=events:raw
SITE_KEYS=gazasafes-web-dev
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
MAX_BATCH_SIZE=20
TRUST_PROXY=false

# worker
CONSUMER_GROUP=workers
CONSUMER_NAME=worker-1
BATCH_SIZE=50
BLOCK_MS=5000
IP_HASH_PEPPER=change-me-to-a-long-random-string
SESSION_GAP_SECONDS=1800

# reporting-api
REPORTING_PORT=8788
API_KEYS=gazasafes-dashboard-dev
MAX_DATE_RANGE_DAYS=92
DEFAULT_SESSIONS_LIMIT=50
MAX_SESSIONS_LIMIT=500
DEFAULT_TOP_PAGES_LIMIT=10
MAX_TOP_PAGES_LIMIT=100
DASHBOARD_CORS_ORIGIN=*

# dashboard
DASHBOARD_PORT=8080
